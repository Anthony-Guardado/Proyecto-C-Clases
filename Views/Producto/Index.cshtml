@model InventaMeCF.Models.ProductoMarcaViewModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>


<p>
    <a asp-action="Crear" class="btn btn-primary">Nuevo Producto</a>
</p>

<form asp-controller="Producto" asp-action="Index" method="get" class="mb-4">
    <div class="row align-items-center">
        <div class="col-auto">
            <select asp-for="ProductoMarca" asp-items="Model.Marcas" class="form-select">
                <option value="0">Todas las marcas</option>
            </select>
        </div>
        <div class="col-auto">
            <input type="text" asp-for="CadenaBusqueda" class="form-control" placeholder="Buscar por nombre..." />
        </div>
        <div class="col-auto">
            <input type="submit" value="Filtrar" class="btn btn-secondary" />
        </div>
    </div>
</form>

@if (Model.Productos != null && Model.Productos.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Productos!.FirstOrDefault()!.Nombre)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Productos!.FirstOrDefault()!.Descripcion)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Productos!.FirstOrDefault()!.PrecioUnitario)
                </th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Productos)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nombre)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Descripcion)
                    </td>
                    <td>
                        @item.PrecioUnitario.ToString("C2")
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        No se encontraron productos registrados.
    </div>
}