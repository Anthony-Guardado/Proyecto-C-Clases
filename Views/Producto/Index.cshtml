@model InventaMeCF.Models.ProductoMarcaViewModel
@using InventaMeCF.Utilidades

@{
    ViewData["Title"] = "Index";

    PaginacionV3 paginacion = ViewBag.Paginacion as PaginacionV3 ?? new PaginacionV3();
    int paginaActual = paginacion.PaginaActual;
}

<h1>Index</h1>

<p>
    <a asp-action="Crear" class="btn btn-primary">Crear Nuevo</a>
</p>

<form asp-controller="Producto" asp-action="Index" method="get" class="mb-3">
    <div class="row align-items-center g-2">
        <div class="col-auto">
            <select asp-for="ProductoMarca" asp-items="Model?.Marcas" class="form-select">
                <option value="0">Todas las Marcas</option>
            </select>
        </div>
        <div class="col-auto">
            <input type="text" asp-for="CadenaBusqueda" class="form-control" placeholder="Buscar por nombre..." />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-secondary btn-sm">Filtrar</button>
        </div>
    </div>
</form>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model?.Productos != null && Model.Productos.Any())
        {
            foreach (var item in Model.Productos)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nombre)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Descripcion)
                    </td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-success btn-sm">Editar</a> |
                        <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center text-muted">No se encontraron productos.</td>
            </tr>
        }
    </tbody>
</table>

<!-- Vista parcial de paginación -->
<partial name="_PaginacionV3" model="@paginacion" />

<div class="shadow-none p-3 mb-5 bg-light rounded mt-3">
    <form asp-controller="Producto" asp-action="ExportarXLSX" method="post">
        <input type="hidden" name="id" value="1" />
        <button type="submit" class="btn btn-success">
            <i class="bi bi-filetype-xlsx" style="width: 1em;"></i>&nbsp;Exportar XLSX
        </button>
    </form>
</div>