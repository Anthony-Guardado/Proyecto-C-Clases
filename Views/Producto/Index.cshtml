@model InventaMeCF.Models.ProductoMarcaViewModel
@using InventaMeCF.Utilidades

@{
    ViewData["Title"] = "Index";

    // Configuración para leer la paginación del ViewBag
    Paginacion paginacion = new Paginacion();
    if (ViewBag.Paginacion != null)
    {
        paginacion = ViewBag.Paginacion;
    }
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <!-- Para leer los nombres de las propiedades desde un ViewModel que contiene una lista -->
            <th>
                @Html.DisplayNameFor(model => model.Productos!.FirstOrDefault()!.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Productos!.FirstOrDefault()!.PrecioUnitario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Productos!.FirstOrDefault()!.Descripcion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        <!-- Ahora iteramos sobre la propiedad Productos que viene dentro de tu ViewModel -->
        @if (Model.Productos != null)
        {
            foreach (var item in Model.Productos)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nombre)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PrecioUnitario)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Descripcion)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<!-- Llamado a tu vista parcial de paginación -->
<partial name="_Paginacion" model="@paginacion" />

<div class="shadow-none p-3 mb-5 bg-light rounded">
    @{
        using (Html.BeginForm("ExportarXLSX", "Producto", FormMethod.Post))
        {
            <input type="hidden" name="id" value="1" />
            <button type="submit" class="btn btn-success"><i class="bi bi-filetype-xlsx" style="width: 1em;">&nbsp;Exportar XLSX</i></button>
        }
        Html.EndForm();
    }
</div>